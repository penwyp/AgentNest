{
  "schemaVersion": 1,
  "id": "openai.codex",
  "displayName": "Codex (CLI)",
  "homeDiscovery": {
    "defaultPaths": [
      "~/.codex",
      "~/.codex-*",
      "~/.codex.*"
    ],
    "environmentVariables": [
      "CODEX_HOME"
    ]
  },
  "fingerprints": {
    "required": [
      {
        "kind": "jsonFile",
        "relativePath": "version.json",
        "versionKeyPath": "version"
      }
    ],
    "optional": [
      {
        "kind": "jsonFile",
        "relativePath": "models_cache.json",
        "versionKeyPath": "client_version"
      }
    ],
    "negative": []
  },
  "skills": [
    {
      "relativePath": "skills",
      "format": "directory-skill-md",
      "writable": true
    }
  ],
  "artifacts": [
    {
      "relativePath": "sessions",
      "category": "sessions",
      "cleanup": {
        "risk": "userContent",
        "method": "officialPermanentDelete",
        "unitBoundary": "adapter",
        "adapterID": "codex.thread"
      }
    },
    {
      "relativePath": "archived_sessions",
      "category": "sessions",
      "cleanup": {
        "risk": "userContent",
        "method": "officialPermanentDelete",
        "unitBoundary": "adapter",
        "adapterID": "codex.thread"
      }
    },
    {
      "relativePath": "plugins/cache",
      "category": "cache",
      "cleanup": {
        "risk": "rebuildable",
        "method": "trash",
        "unitBoundary": "root"
      }
    },
    {
      "relativePath": ".tmp",
      "category": "cache",
      "cleanup": {
        "risk": "rebuildable",
        "method": "trash",
        "unitBoundary": "root"
      }
    },
    {
      "relativePath": "log",
      "category": "logs",
      "cleanup": {
        "risk": "rebuildable",
        "method": "trash",
        "unitBoundary": "root"
      }
    }
  ],
  "capabilities": {
    "space": true,
    "skills": true,
    "activity": false,
    "cleanup": true
  },
  "marketplace": {
    "summary": "OpenAI's terminal coding agent.",
    "homepageURL": "https://openai.com/codex",
    "install": {
      "kind": "cask",
      "formula": "codex"
    }
  }
}
