{
  "schemaVersion": 1,
  "id": "openai.codex",
  "displayName": "Codex",
  "homeDiscovery": {
    "defaultPaths": ["~/.codex", "~/.codex-*", "~/.codex.*"],
    "environmentVariables": ["CODEX_HOME"]
  },
  "fingerprints": {
    "required": [
      { "kind": "jsonFile", "relativePath": "version.json" }
    ],
    "optional": [],
    "negative": []
  },
  "skills": [
    { "relativePath": "skills", "format": "directory-skill-md", "writable": true }
  ],
  "artifacts": [],
  "capabilities": {
    "space": true,
    "skills": true,
    "activity": false,
    "cleanup": false
  }
}
